<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <CheckBox
        android:id="@+id/checkBoxIdTrxOpenBill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:buttonTint="#FF9800"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewIdTrx"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="start|center_vertical"
        android:singleLine="true"
        android:text="1234567891011"
        android:textColor="#000000"
        android:textIsSelectable="false"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/checkBoxIdTrxOpenBill"
        app:layout_constraintStart_toEndOf="@+id/checkBoxIdTrxOpenBill"
        app:layout_constraintTop_toTopOf="@+id/checkBoxIdTrxOpenBill" />

    <TextView
        android:id="@+id/textViewMG"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:shadowColor="#020202"
        android:textColor="#E91E63"
        android:textIsSelectable="false"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewIdTrx"
        app:layout_constraintStart_toEndOf="@+id/textViewIdTrx"
        app:layout_constraintTop_toTopOf="@+id/textViewIdTrx" />

    <TextView
        android:id="@+id/textViewTotalTrxOpenBill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:text="TextView"
        android:textColor="#000000"
        android:textIsSelectable="false"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/textViewMG"
        app:layout_constraintEnd_toStartOf="@+id/buttondetails"
        app:layout_constraintStart_toEndOf="@+id/textViewMG"
        app:layout_constraintTop_toTopOf="@+id/textViewMG"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/buttondetails"
        android:layout_width="35dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_format_list_numbered_black_24dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/textViewTotalTrxOpenBill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewTotalTrxOpenBill"
        app:layout_constraintTop_toTopOf="@+id/textViewTotalTrxOpenBill" />

</androidx.constraintlayout.widget.ConstraintLayout>