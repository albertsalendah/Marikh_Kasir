<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".activities.Main_Menu">


    <TextView
        android:id="@+id/textViewMainMenu"
        style="@style/purchasing_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Main Menu"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingMainMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A84A4A4A"
        android:elevation="5dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBarMainMenu"
            style="?android:attr/progressBarStyle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewLoadingMainMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Now Loading..."
            android:textColor="#E1E1E1"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/progressBarMainMenu"
            app:layout_constraintStart_toStartOf="@+id/progressBarMainMenu"
            app:layout_constraintTop_toBottomOf="@+id/progressBarMainMenu" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/buttonLogOut"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/shutdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewMainMenu">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <GridLayout
                android:id="@+id/gridLayout7"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:columnCount="4"
                android:rowCount="3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonLogOut">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonPurchasing"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/purchase_or"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/purchaseorder"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/purchasing_"
                        android:layout_width="135dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="top"
                        android:text="PurchasingTransaction"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonTransaksi"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:background="@drawable/rectangle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:id="@+id/us_dollar"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/usdollar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/selling_tra"
                        android:layout_width="135dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="top"
                        android:text="Selling  Transaction"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonMember"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/user_groups"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:layout_marginEnd="31dp"
                        android:background="@drawable/usergroups"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/member"
                        android:layout_width="97dp"
                        android:layout_height="33dp"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="35dp"
                        android:gravity="top"
                        android:text="Member"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonPaymentMethod"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/mind_map"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/mindmap"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/payment_met"
                        android:layout_width="102dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="31dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="top"
                        android:text="PaymentMethod"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>


                <!--2nd row starts from here.-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonDiskonManagement"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/discount"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/discount"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/discount_ma"
                        android:layout_width="151dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="31dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="top"
                        android:text="Discount  Management"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonprodukmenajement"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/database_ad"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/databaseadministrator"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/product_man"
                        android:layout_width="151dp"
                        android:layout_height="66dp"
                        android:layout_marginStart="31dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="top"
                        android:text="Product  Management"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/profit"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/profit"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/accounting"
                        android:layout_width="132dp"
                        android:layout_height="33dp"
                        android:layout_marginStart="31dp"
                        android:layout_marginBottom="35dp"
                        android:gravity="top"
                        android:text="Accounting"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:id="@+id/gears"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/combochart"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/report"
                        android:layout_width="78dp"
                        android:layout_height="33dp"
                        android:layout_marginBottom="35dp"
                        android:gravity="top"
                        android:text="Report"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/gears"
                        app:layout_constraintStart_toStartOf="@+id/gears" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/buttonSettings"
                    android:layout_width="190dp"
                    android:layout_height="150dp"
                    android:background="@drawable/rectangle">

                    <View
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/gears"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/setting"
                        android:layout_width="82dp"
                        android:layout_height="33dp"
                        android:layout_marginStart="31dp"
                        android:layout_marginBottom="35dp"
                        android:gravity="top"
                        android:text="Setting"
                        android:textAppearance="@style/purchasing_"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <!--<TextView
            android:id="@+id/textView5"
            android:layout_row="1"
            android:layout_column="0"
            android:text="E"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:padding="30dp"/>

        <TextView
            android:id="@+id/textView6"
            android:layout_row="1"
            android:layout_column="1"
            android:text="F"
            android:padding="30dp"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/textView7"
            android:layout_row="1"
            android:layout_column="2"
            android:text="G"
            android:padding="30dp"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/textView8"
            android:layout_row="1"
            android:layout_column="3"
            android:text="H"
            android:padding="30dp"
            android:textAppearance="?android:attr/textAppearanceLarge" />-->

                <!--3nd row starts from here.-->


            </GridLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>