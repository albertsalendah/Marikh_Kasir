<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".activities.produk.TambahEditProduct">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressBarAddProduk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A84A4A4A"
        android:elevation="5dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBar6"
            style="?android:attr/progressBarStyle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView56"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Now Loading..."
            android:textColor="#E1E1E1"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/progressBar6"
            app:layout_constraintStart_toStartOf="@+id/progressBar6"
            app:layout_constraintTop_toBottomOf="@+id/progressBar6" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/productMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="New/Edit Product"
                android:textColor="#000000"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:columnCount="4"
                android:padding="4dp"
                android:rowCount="10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/productMode">

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Category"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Product Name"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="2"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Product price"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textView12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="3"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Product quantity"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textView13"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="4"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Product Discount (%)  "
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textView14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="5"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Discount duration"
                    android:textColor="#000000"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="5"
                    android:layout_column="2"
                    android:layout_gravity="center"
                    android:text="until"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textViewDiskonOlfood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="6"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Discount Olfood"
                    android:textColor="#000000"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="8"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Product Picture"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textView37"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="7"
                    android:layout_column="2"
                    android:layout_gravity="center"
                    android:text="until"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textView16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="7"
                    android:layout_column="0"
                    android:layout_gravity="center_vertical"
                    android:text="Olfood discount duration"
                    android:textColor="#000000"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/editTextKategori"
                    android:layout_width="200dp"
                    android:layout_height="45dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:editable="false"
                    android:ems="10"
                    android:gravity="center"
                    android:inputType="textPersonName"
                    android:textColor="#000000"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/editTextProduct"
                    android:layout_width="200dp"
                    android:layout_height="45dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:ems="10"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="textPersonName"
                    android:text=""
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/editTextHargaProduct"
                    android:layout_width="200dp"
                    android:layout_height="45dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:ems="10"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="number"
                    android:numeric="integer"
                    android:text=""
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/editTextJumlahProduct"
                    android:layout_width="200dp"
                    android:layout_height="45dp"
                    android:layout_row="3"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:ems="10"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="number"
                    android:numeric="integer"
                    android:text=""
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/editTextDiskonProduct"
                    android:layout_width="200dp"
                    android:layout_height="45dp"
                    android:layout_row="4"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:ems="10"
                    android:imeOptions="flagNoExtractUi"
                    android:inputType="number"
                    android:text=""
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/editTextDurasiAwalDiskonProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="5"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:editable="false"
                    android:ems="10"
                    android:gravity="center"
                    android:text="DD/MM/YYYY"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/editTextDurasiAkhirDiskonProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="5"
                    android:layout_column="3"
                    android:layout_gravity="center"
                    android:editable="false"
                    android:ems="10"
                    android:gravity="center"
                    android:text="DD/MM/YYYY"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/editTextDiskonOlfood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="6"
                    android:layout_column="1"
                    android:ems="10"
                    android:inputType="number"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/textViewDurasi_Awal_Diskon_Olfood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="7"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:text="DD/MM/YYYY"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textViewDurasi_Akhir_Diskon_Olfood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_row="7"
                    android:layout_column="3"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="DD/MM/YYYY"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/previewProduct"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_row="8"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/logomarikh" />

                <Button
                    android:id="@+id/buttonTambahEditProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_row="9"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:background="@drawable/button_white"
                    android:padding="8dp"
                    android:text="Product"
                    android:textColor="#000000" />


            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>